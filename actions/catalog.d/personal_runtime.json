{
  "release": "Personal Autonomy Foundation - Phase 2",
  "actions": [
    {
      "id": "observe.passive.start",
      "engine": "observe",
      "group": "personal_context",
      "operation": "start_passive",
      "description": "Ativa o observador pessoal persistente de baixo custo. Registra mudanças de aplicativo/janela e contexto estrutural, sem gravar conteúdo digitado.",
      "params": {
        "interval_seconds": {
          "default": 2.0
        }
      },
      "risk": "act",
      "keywords": [
        "observador pessoal",
        "aprendizado contínuo",
        "contexto",
        "atividade",
        "trabalho",
        "desktop",
        "observar"
      ]
    },
    {
      "id": "observe.passive.stop",
      "engine": "observe",
      "group": "personal_context",
      "operation": "stop_passive",
      "description": "Desativa o observador pessoal persistente preservando o histórico de atividade já registrado.",
      "params": {},
      "risk": "act",
      "keywords": [
        "observador pessoal",
        "parar observação",
        "aprendizado contínuo",
        "contexto"
      ]
    },
    {
      "id": "observe.passive.status",
      "engine": "observe",
      "group": "personal_context",
      "operation": "passive_status",
      "description": "Mostra se o observador pessoal está ativo e quantos eventos estruturais já foram registrados.",
      "params": {},
      "risk": "read",
      "keywords": [
        "observador pessoal",
        "status",
        "aprendizado contínuo",
        "contexto"
      ]
    },
    {
      "id": "observe.context.current",
      "engine": "observe",
      "group": "personal_context",
      "operation": "current_context",
      "description": "Lê o contexto atual do desktop: aplicativo, processo, título da janela e documento/projeto provável.",
      "params": {
        "record": {
          "default": false
        }
      },
      "risk": "read",
      "keywords": [
        "o que estou fazendo",
        "contexto atual",
        "desktop",
        "aplicativo atual",
        "janela ativa",
        "trabalho atual"
      ]
    },
    {
      "id": "observe.activity.recent",
      "engine": "observe",
      "group": "personal_activity",
      "operation": "recent_activity",
      "description": "Retorna uma linha do tempo recente de mudanças de contexto e eventos estruturados observados no computador.",
      "params": {
        "minutes": {
          "default": 30
        },
        "limit": {
          "default": 100
        }
      },
      "risk": "read",
      "keywords": [
        "atividade recente",
        "histórico de trabalho",
        "o que eu fiz",
        "contexto",
        "timeline"
      ]
    },
    {
      "id": "observe.activity.summary",
      "engine": "observe",
      "group": "personal_activity",
      "operation": "activity_summary",
      "description": "Resume aplicativos, eventos e transições de contexto observados em uma janela de tempo.",
      "params": {
        "minutes": {
          "default": 60
        }
      },
      "risk": "read",
      "keywords": [
        "resumo de atividade",
        "trabalho",
        "aplicativos",
        "contexto",
        "produtividade"
      ]
    },
    {
      "id": "observe.activity.patterns",
      "engine": "observe",
      "group": "personal_learning",
      "operation": "activity_patterns",
      "description": "Detecta sequências repetidas de aplicativos/contextos como evidência para futuras rotinas aprendidas. Não cria automações automaticamente.",
      "params": {
        "minutes": {
          "default": 480
        },
        "min_count": {
          "default": 2
        },
        "limit": {
          "default": 12
        }
      },
      "risk": "read",
      "keywords": [
        "padrões",
        "rotinas",
        "hábitos",
        "aprendizado",
        "trabalho repetido",
        "procedimento"
      ]
    },
    {
      "id": "observe.context.operational",
      "engine": "observe",
      "group": "personal_context",
      "operation": "operational_context",
      "description": "Monta o contexto operacional pessoal combinando aplicativo atual, último episódio de trabalho, experiência por aplicativo, rotinas aprendidas e padrões recentes.",
      "params": {
        "minutes": {
          "default": 120
        },
        "max_procedures": {
          "default": 5
        },
        "query": {
          "default": ""
        }
      },
      "risk": "read",
      "keywords": [
        "contexto operacional",
        "onde parei",
        "continue de onde parei",
        "memória de trabalho",
        "personal context",
        "working context"
      ]
    },
    {
      "id": "observe.context.packet",
      "engine": "observe",
      "group": "personal_context",
      "operation": "context_packet",
      "description": "Gera um pacote compacto e model-friendly do contexto operacional, preparado para futura injeção automática no prompt do agente.",
      "params": {
        "minutes": {
          "default": 120
        },
        "max_chars": {
          "default": 3200
        },
        "query": {
          "default": ""
        }
      },
      "risk": "read",
      "keywords": [
        "context packet",
        "contexto compacto",
        "prompt context",
        "working context",
        "memória operacional"
      ]
    },
    {
      "id": "observe.work.episodes",
      "engine": "observe",
      "group": "personal_activity",
      "operation": "work_episodes",
      "description": "Agrupa eventos do observador em episódios contínuos de trabalho, identificando aplicativos, documentos e duração aproximada.",
      "params": {
        "minutes": {
          "default": 240
        },
        "gap_seconds": {
          "default": 300
        },
        "limit": {
          "default": 20
        }
      },
      "risk": "read",
      "keywords": [
        "episódios",
        "sessões de trabalho",
        "onde parei",
        "atividade",
        "timeline",
        "workflow observado"
      ]
    },
    {
      "id": "observe.procedures.list",
      "engine": "observe",
      "group": "procedural_memory",
      "operation": "list_procedures",
      "description": "Lista rotinas aprendidas e persistidas na memória procedural, com maturidade, confiança, aplicativos e quantidade de passos.",
      "params": {
        "limit": {
          "default": 30
        },
        "app_id": {
          "default": ""
        }
      },
      "risk": "read",
      "keywords": [
        "memória procedural",
        "procedimentos aprendidos",
        "rotinas aprendidas",
        "skills observadas",
        "experiência"
      ]
    },
    {
      "id": "observe.procedures.search",
      "engine": "observe",
      "group": "procedural_memory",
      "operation": "search_procedures",
      "description": "Recupera rotinas aprendidas semelhantes a um objetivo ou ao aplicativo atual para orientar um novo plano.",
      "params": {
        "query": {
          "required": true
        },
        "limit": {
          "default": 8
        },
        "app_id": {
          "default": ""
        }
      },
      "risk": "read",
      "keywords": [
        "buscar rotina",
        "procedimento semelhante",
        "demonstração",
        "experiência anterior",
        "RAG procedural"
      ]
    },
    {
      "id": "observe.procedures.stats",
      "engine": "observe",
      "group": "procedural_memory",
      "operation": "procedure_stats",
      "description": "Mostra o nível de maturidade das rotinas aprendidas: learned, practiced, trusted e autonomous.",
      "params": {},
      "risk": "read",
      "keywords": [
        "autonomia",
        "maturidade",
        "procedimentos",
        "confiança",
        "aprendizado"
      ]
    },
    {
      "id": "observe.experts.list",
      "engine": "observe",
      "group": "application_experts",
      "operation": "app_expertise",
      "description": "Mostra os especialistas por aplicativo derivados do uso observado e das demonstrações aprendidas.",
      "params": {
        "minutes": {
          "default": 10080
        },
        "limit": {
          "default": 30
        }
      },
      "risk": "read",
      "keywords": [
        "app expert",
        "application expert",
        "especialista photoshop",
        "especialista vscode",
        "experiência por aplicativo",
        "UFO appagent"
      ]
    },
    {
      "id": "observe.learning.snapshot",
      "engine": "observe",
      "group": "personal_learning",
      "operation": "learning_snapshot",
      "description": "Resume o estado do aprendizado pessoal: episódios, aplicativos observados, especialistas, rotinas persistidas e padrões repetidos.",
      "params": {
        "minutes": {
          "default": 10080
        }
      },
      "risk": "read",
      "keywords": [
        "status aprendizado",
        "autonomia",
        "o que aprendeu",
        "learning snapshot",
        "personal gpt"
      ]
    }
  ]
}